{
  "name": "conventionalcomments.io",
  "private": true,
  "type": "module",
  "description": "Le site conventionalcomments.io — vitrine de conventional-comments-toolkit.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node scripts/generate-version.mjs && astro dev",
    "build": "node scripts/generate-version.mjs && astro build",
    "preview": "astro preview",
    "check": "npm run build && node scripts/check-site.mjs && npm run check:schema && npm run check:toolkit && npm run check:labels && npm run check:notes",
    "check:site": "node scripts/check-site.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "deploy": "npm run check && wrangler deploy",
    "check:toolkit": "node scripts/check-toolkit-sync.mjs",
    "check:labels": "node scripts/audit-labels.mjs",
    "check:notes": "node scripts/check-release-notes.mjs"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^5.18.2",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=20"
  }
}
