---
import Base from '../../layouts/Base.astro';
import { href } from '../../i18n/routes';
import BuildFacts from '../../components/BuildFacts.astro';
import SiteReleaseCard from '../../components/SiteReleaseCard.astro';
import { siteRelease, siteReleaseIn, previousSiteReleasesIn } from '../../site-release';

const lang = 'fr' as const;
const page = 'version' as const;

const latest = siteReleaseIn(lang);
const previous = previousSiteReleasesIn(lang);
---
<Base lang={lang} page={page} noindex
  title="Version"
  description="Quelle release est en ligne, depuis quel commit, construite quand.">
<section class="hband">
      <div class="in">
        <div class="stack g18 measure">
          <span class="eyebrow acc">ce build&nbsp;:</span>
          <h1 style="font-size:clamp(27px,3.4vw,36px);font-weight:700;letter-spacing:-.03em;line-height:1.06">Dernière release</h1>
          <p class="lede">Ce qui vous est servi en ce moment, et d'où ça vient. Une liste de déploiements donne des horaires&nbsp;; ceci donne un commit. Les mêmes informations sont servies en JSON sur <code>/version.json</code> — un seul fichier, généré une fois par build, pour que la page et l'endpoint ne puissent pas nommer deux builds différents.</p>
        </div>

        <BuildFacts lang={lang} />
        <p class="small measure"><code>release</code> est vide sur tout build qui ne vient pas d'un tag de release — c'est-à-dire tout build de branche. <code>commit</code> n'est vide que là où il n'y avait pas de git à lire. <code>built</code> est toujours une heure.</p>
      </div>
    </section>

    <section class="hband sunk">
      <div class="in">
        <div class="stack g14 measure">
          <span class="eyebrow">ce qu'elle a changé&nbsp;:</span>
          <h2>Dernière release</h2>
          <p style="font-size:15px;color:var(--fg-2);line-height:1.6">Cette section nomme ce que la release ci-dessus a apporté — lu depuis le <code>RELEASE_NOTES-fr.md</code> de ce dépôt, pas celui du toolkit. Les notes de version du toolkit, qui sont autre chose, sont sur <a href={href('releasenotes', 'fr')}>notes de version</a>.</p>
        </div>
        <SiteReleaseCard locale={lang} release={latest} />
      </div>
    </section>

    <section class="hband">
      <div class="in">
        <div class="stack g14 measure">
          <span class="eyebrow">releases précédentes&nbsp;:</span>
          <h2>Ce qui est venu avant</h2>
        </div>
        {previous.length > 0 ? (
          <div class="stack g18">
            {previous.map((release) => <SiteReleaseCard locale={lang} release={release} />)}
          </div>
        ) : (
          <p style="font-size:15px;color:var(--fg-2);line-height:1.6">C'est la première release — il n'y a rien avant elle.</p>
        )}
        <p class="small measure">{siteRelease.moreTag !== null ? "Des releases plus anciennes existent au-delà de cette liste." : "Toutes les releases jamais poussées par ce site sont listées ci-dessus."} Elles sont toutes listées sur <a href="https://github.com/Reefact/conventionalcomments.io/tags" rel="noopener noreferrer" target="_blank">la page des tags du dépôt ↗</a>.</p>
      </div>
    </section>
</Base>
