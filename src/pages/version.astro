---
import Base from '../layouts/Base.astro';
import { href } from '../i18n/routes';
import BuildFacts from '../components/BuildFacts.astro';
import SiteReleaseCard from '../components/SiteReleaseCard.astro';
import { siteRelease, siteReleaseIn, previousSiteReleasesIn } from '../site-release';
import version from '../generated/version.json';

const lang = 'en' as const;
const page = 'version' as const;

const latest = siteReleaseIn(lang);
const previous = previousSiteReleasesIn(lang);
/* `version.release` is null on any build that did not come from a release tag — every
   branch build. On such a build the card below is the site's most recent shipped release,
   not a description of what this particular build brought: it must not be captioned as if
   the two were the same thing. */
const isCurrentBuildsRelease = version.release !== null;
---
<Base lang={lang} page={page} noindex
  title="Version"
  description="Which release is live, from which commit, built when.">
<section class="hband">
      <div class="in">
        <div class="stack g18 measure">
          <span class="eyebrow acc">this build:</span>
          <h1 style="font-size:clamp(27px,3.4vw,36px);font-weight:700;letter-spacing:-.03em;line-height:1.06">Latest release</h1>
          <p class="lede">What you are being served right now, and where it came from. Deployment lists report times; this reports a commit. The same facts are served as JSON at <code>/version.json</code> — one file, generated once per build, so the page and the endpoint cannot name two different builds.</p>
        </div>

        <BuildFacts lang={lang} />
        <p class="small measure"><code>release</code> is empty on any build that did not come from a release tag — every build on a branch. <code>commit</code> is empty only where there was no git to read. <code>built</code> is always a time.</p>
      </div>
    </section>

    <section class="hband sunk">
      <div class="in">
        <div class="stack g14 measure">
          <span class="eyebrow">what it changed:</span>
          <h2>{isCurrentBuildsRelease ? 'Latest release' : "The site's most recent release"}</h2>
          {isCurrentBuildsRelease ? (
            <p style="font-size:15px;color:var(--fg-2);line-height:1.6">This section names what the release above brought — read from this repository's own <code>RELEASE_NOTES-en.md</code>, not from the toolkit. The toolkit's own release notes, which are a different thing, are at <a href={href('releasenotes', 'en')}>release notes</a>.</p>
          ) : (
            <p style="font-size:15px;color:var(--fg-2);line-height:1.6">This build did not come from a release tag — the <code>release</code> row above is empty — so it did not ship what is named below. Shown instead is the most recent release this site has actually published, read from this repository's own <code>RELEASE_NOTES-en.md</code>, not from the toolkit. The toolkit's own release notes, which are a different thing, are at <a href={href('releasenotes', 'en')}>release notes</a>.</p>
          )}
        </div>
        <SiteReleaseCard locale={lang} release={latest} />
      </div>
    </section>

    <section class="hband">
      <div class="in">
        <div class="stack g14 measure">
          <span class="eyebrow">previous releases:</span>
          <h2>What came before</h2>
        </div>
        {previous.length > 0 ? (
          <div class="stack g18">
            {previous.map((release) => <SiteReleaseCard locale={lang} release={release} />)}
          </div>
        ) : (
          <p style="font-size:15px;color:var(--fg-2);line-height:1.6">This is the first release — there is nothing before it.</p>
        )}
        <p class="small measure">{siteRelease.moreTag !== null ? 'Earlier releases exist beyond this list.' : 'Every release this site has ever pushed is shown above.'} All of them are listed on <a href="https://github.com/Reefact/conventionalcomments.io/tags" rel="noopener noreferrer" target="_blank">the repository's tag page ↗</a>.</p>
      </div>
    </section>
</Base>
