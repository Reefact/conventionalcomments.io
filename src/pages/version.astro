---
import Base from '../layouts/Base.astro';
import { href } from '../i18n/routes';
import BuildFacts from '../components/BuildFacts.astro';

const lang = 'en' as const;
const page = 'version' as const;
---
<Base lang={lang} page={page} noindex
  title="Version"
  description="Which release is live, from which commit, built when.">
<section class="hband">
      <div class="in">
        <div class="stack g18 measure">
          <span class="eyebrow acc">this build:</span>
          <h1 style="font-size:clamp(27px,3.4vw,36px);font-weight:700;letter-spacing:-.03em;line-height:1.06">Latest release</h1>
          <p class="lede">What you are being served right now, and where it came from. Deployment lists report times; this reports a commit. The same facts are served as JSON at <code>/version.json</code> — one file, generated once per build, so the page and the endpoint cannot name two different builds.</p>
        </div>

        <BuildFacts lang={lang} />
        <p class="small measure"><code>release</code> is empty on any build that did not come from a release tag — every build on a branch. <code>commit</code> is empty only where there was no git to read. <code>built</code> is always a time.</p>
      </div>
    </section>

    <section class="hband sunk">
      <div class="in">
        <div class="stack g14 measure">
          <span class="eyebrow">what it changed:</span>
          <h2>Nothing to report yet</h2>
          <p style="font-size:15px;color:var(--fg-2);line-height:1.6">This section names what the release above brought. There is no release above — the <code>release</code> row is empty — so there is nothing to name. It fills itself the day a <code>release/*</code> tag is pushed.</p>
          <p style="font-size:15px;color:var(--fg-2);line-height:1.6">The toolkit's own release notes, which are a different thing and do exist, are at <a href={href('releasenotes', 'en')}>release notes</a>.</p>
        </div>
      </div>
    </section>

    <section class="hband">
      <div class="in">
        <div class="stack g14 measure">
          <span class="eyebrow">previous releases:</span>
          <h2>What came before</h2>
          <p style="font-size:15px;color:var(--fg-2);line-height:1.6">Nothing yet. No <code>release/*</code> tag has been pushed, so this site has no release history to show — and inventing one on the page whose whole job is to state facts about the build would be the worst place for it.</p>
          <p style="font-size:15px;color:var(--fg-2);line-height:1.6">Once tags exist they are listed on <a href="https://github.com/Reefact/conventionalcomments.io/tags" rel="noopener noreferrer" target="_blank">the repository's tag page ↗</a>, and the <code>release</code> row above names the one this build came from.</p>
        </div>
      </div>
    </section>
</Base>
