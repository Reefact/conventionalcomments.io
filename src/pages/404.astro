---
import Base from '../layouts/Base.astro';
import { href } from '../i18n/routes';
const lang = 'en' as const;
---
<Base lang={lang} page="docsindex" noindex title="Page not found" description="That address does not exist on this site.">
  <section class="hband">
    <div class="in">
      <div class="stack g18 measure">
        <span class="eyebrow acc">404:</span>
        <h1 style="font-size:clamp(29px,3.8vw,41px);font-weight:700;letter-spacing:-.031em;line-height:1.05">That address doesn't exist here.</h1>
        <p class="lede">Either it never did, or it moved. The documentation index is the fastest way back to whatever you were after.</p>
        <div class="hero-btns">
          <a class="btn btn-p" href={href('docsindex', lang)}>Documentation</a>
          <a class="btn btn-s" href={href('home', lang)}>Home</a>
        </div>
      </div>
    </div>
  </section>
</Base>
