{
  "$schema": "https://conventionalcomments.io/schema/v1.json",
  "version": 1,
  "mode": "enforce",
  "labels": [
    { "id": "issue", "enabled": true, "blockingByDefault": true, "alwaysNonBlocking": false, "icon": "🔨", "color": "#E04E45", "aliases": ["bug"], "description": "A problem that must be fixed.", "usage": "Report a problem to fix." },
    { "id": "quibble", "enabled": true },
    { "id": "followup", "kind": "reply", "icon": "🧭" }
  ],
  "decorations": {
    "allowFree": true,
    "known": [
      { "id": "blocking", "forces": "blocking" },
      { "id": "if-minor", "forces": "non-blocking" },
      { "id": "security", "forces": null }
    ]
  },
  "severities": { "W-MISSING-DECORATION": "off", "E-CONFLICT": "error", "W-SESSION-MULTIPLE": "warn" },
  "scope": { "validateReplies": false, "validateReviewSummary": true },
  "rules": { "minSubjectLength": 5, "maxSubjectLength": 120, "minDecisionSubjectLength": 20 },
  "exemptUsers": ["dependabot[bot]"],
  "allowlistPatterns": ["^LGTM$"],
  "toolCommands": ["/*", "@dependabot", "@renovate"],
  "configUrl": null,
  "coreMinVersion": "1.0.0",
  "configCacheTtlSeconds": 3600,
  "badgeStyle": "pill",
  "sessionIcon": "🤖",
  "shortcuts": { "abbreviations": { "?i": "issue: " } },
  "language": "fr",
  "telemetry": { "enabled": false, "endpoint": null }
}
